# Local development only. Production values come from your secret manager.
DATABASE_URL=postgresql://studypal:studypal@localhost:5432/studypal
DATABASE_POOL_MAX=10
# API defaults to development. Set NODE_ENV=production in the deployed API environment.
# Keep NODE_ENV out of this file: Vite also reads it during production builds.
API_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=info
ENABLE_API_DOCS=false
RATE_LIMIT_MAX=100
API_TRUST_PROXY_HOPS=0
# Omit VITE_API_BASE_URL to use the browser origin + Vite's /api proxy.
# Every VITE_* value is public and embedded in the web bundle. Never put secrets here.

# Copy the publishable key in Clerk and run: pbpaste | node scripts/configure-clerk.mjs
WORKSPACE_AUTH_MODE=clerk
VITE_WORKSPACE_AUTH_MODE=clerk
# VITE_CLERK_PUBLISHABLE_KEY=
# The setup command reads the instance's public settings to configure these options.
VITE_CLERK_GOOGLE_ENABLED=false
VITE_CLERK_NAME_FIELDS=false
# CLERK_ISSUER=
# Optional server-side pinned public verification key instead of rotating public JWKS.
# CLERK_JWT_KEY=
# Legacy offline installation recovery: set both mode variables to local, then pair.
# This generates WORKSPACE_OWNER_ID and WORKSPACE_PAIRING_KEY in your private .env.
# Keep the owner UUID stable across upgrades and key rotations.
# Optional paid quiz generation and written feedback. Supply this server-side only.
# OPENAI_API_KEY=
FRONTIER_DAILY_BUDGET_CENTS=100
FRONTIER_USER_DAILY_BUDGET_CENTS=25
