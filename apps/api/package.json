{
  "name": "@studypal/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently --kill-others \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "frontier:worker": "node dist/frontier-worker.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "openapi:generate": "node dist/scripts/export-openapi.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test dist-test/test/*.integration.js"
  },
  "dependencies": {
    "@clerk/backend": "3.31.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.12",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-fastify": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "@studypal/database": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@studypal/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "concurrently": "9.2.1",
    "typescript": "5.9.3"
  }
}
