{
  "name": "@studypal/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "openapi-typescript ../api-contract/openapi.json --output src/generated/schema.ts",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@studypal/api-contract": "workspace:*",
    "@studypal/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
