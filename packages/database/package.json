{
  "name": "@studypal/database",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/client.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test dist-test/test/integration.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build && node dist/scripts/migrate.js",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@studypal/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  },
  "typesVersions": {
    "*": {
      "schema": [
        "dist/schema/index.d.ts"
      ]
    }
  }
}
